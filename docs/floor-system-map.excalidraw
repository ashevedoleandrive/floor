    {
      "type": "text",
      "id": "q_note",
      "x": 84,
      "y": 1868,
      "width": 1200,
      "height": 16,
      "text": "Band order is fixed in code, so two SDRs opening the queue on Monday see the same order.",
      "originalText": "Band order is fixed in code, so two SDRs opening the queue on Monday see the same order.",
      "fontSize": 12,
