    {
      "type": "text",
      "id": "q_foot",
      "x": 60,
      "y": 1938,
      "width": 1200,
      "height": 34,
      "text": "Every claim, verdict, trace and token cost is written to D1, so a run can be audited after the fact, and the queue exports Salesforce shaped.\nMeasured cost, about $0.26 to $0.29 per account, reported per stage from real token counts.",
      "originalText": "Every claim, verdict, trace and token cost is written to D1, so a run can be audited after the fact, and the queue exports Salesforce shaped.\nMeasured cost, about $0.26 to $0.29 per account, reported per stage from real token counts.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
